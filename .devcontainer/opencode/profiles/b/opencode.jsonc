{
  "$schema": "https://opencode.ai/config.json",
  // Profile B: ZeroKit product testing environment.
  // Runs ZeroKit AS a whitebox pentester against a target repository.
  // Does NOT develop ZeroKit — use Profile A (opencode-a) for that.
  "autoupdate": false,
  "share": "disabled",
  "plugin": [
    "oh-my-opencode@latest"
  ],
  // Load the full agent methodology + skills for security research.
  "instructions": [
    ".agent/agent.md",
    ".agent/HARNESS_SCOPE.md",
    ".agent/methodology/phase_config.json"
  ]
}
