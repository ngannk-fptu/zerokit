{
  "$schema": "https://opencode.ai/config.json",
  // Profile A: ZeroKit development environment.
  // The ZeroKit pentest agents live in .opencode/agents/ (part of the repo).
  // This profile provides the isolated dev runtime with Copilot model access.
  "autoupdate": false,
  "share": "disabled",
  "plugin": [
    "oh-my-opencode@latest"
  ],
  // Load the ZeroKit agent instructions as context for development.
  "instructions": [
    ".agent/agent.md",
    ".agent/HARNESS_SCOPE.md"
  ]
}
